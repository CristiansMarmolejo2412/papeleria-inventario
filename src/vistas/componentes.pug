mixin icono(nombre)
  svg.icono(aria-hidden='true' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round')
    case nombre
      when 'inicio'
        path(d='M3 10 12 3l9 7v10H4V10M9 20v-7h6v7')
      when 'productos'
        path(d='m12 3 9 5-9 5-9-5 9-5ZM3 8v10l9 5 9-5V8M12 13v10')
      when 'ventas'
        path(d='M2 3h3l3 13h11l3-10H6M9 21h.01M18 21h.01')
      when 'buscar'
        circle(cx='10' cy='10' r='6')
        path(d='m15 15 6 6')
      when 'alerta'
        path(d='m12 3 10 18H2L12 3ZM12 9v5M12 17h.01')
      when 'caja'
        rect(x='3' y='7' width='18' height='14' rx='2')
        path(d='M8 7V3h8v4M3 12h18M12 10v5')
      when 'menu'
        path(d='M4 6h16M4 12h16M4 18h16')
      when 'mas'
        path(d='M12 5v14M5 12h14')
      when 'clientes'
        circle(cx='12' cy='7' r='4')
        path(d='M4 21v-3a8 8 0 0 1 16 0v3')
      when 'ajustes'
        circle(cx='12' cy='12' r='4')
        path(d='M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M5 19l2-2M17 7l2-2')
      default
        rect(x='5' y='3' width='14' height='18' rx='2')
        path(d='M9 8h6M9 12h6M9 16h4')

mixin campo(nombre, etiqueta, tipo, valor, errores, opciones)
  .campo
    label(for=nombre)= etiqueta
    input(id=nombre name=nombre type=tipo value=valor == null ? '' : valor aria-invalid=errores[nombre] ? 'true' : 'false' aria-describedby=errores[nombre] ? nombre+'-error' : undefined)&attributes(opciones || {})
    if errores[nombre]
      p.error-campo(id=nombre+'-error')= errores[nombre]

mixin estado(producto)
  - const texto = disponibilidad(producto)
  span.etiqueta(class=texto === 'Disponible' ? 'verde' : texto === 'Pocas existencias' ? 'amarilla' : texto === 'Agotado' ? 'coral' : 'gris')
    span.punto
    = texto
