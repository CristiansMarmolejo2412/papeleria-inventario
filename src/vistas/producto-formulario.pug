extends base
block contenido
  section.tarjeta.formulario-panel
    .encabezado-panel
      div
        h2= edicion ? 'Información del producto' : 'Un nuevo producto para tu inventario'
        p.subtitulo Los campos con * son obligatorios. Importes en COP, con punto decimal.
      a.enlace(href='/productos') Volver a productos
    if Object.keys(errores).length
      .aviso.error(role='alert') Revisa los campos indicados. Tus datos se conservan para corregirlos.
    if !categorias.some(c => c.activo)
      .aviso.error Primero debes crear o activar una categoría.
        a.enlace(href='/categorias') Gestionar categorías
    form(method='post' action=edicion ? '/productos/'+datos.id : '/productos' data-guardar)
      input(type='hidden' name='_csrf' value=csrf)
      .formulario-rejilla
        +campo('codigo','Código interno *','text',datos.codigo,errores,{maxlength:40,required:true})
        +campo('barras','Código de barras','text',datos.barras,errores,{maxlength:80})
        +campo('nombre','Nombre *','text',datos.nombre,errores,{maxlength:120,required:true})
        .campo
          label(for='categoriaId') Categoría *
          select#categoriaId(name='categoriaId' required aria-invalid=errores.categoriaId ? 'true' : 'false' aria-describedby=errores.categoriaId ? 'categoriaId-error' : undefined)
            option(value='') Seleccionar categoría
            each categoria in categorias
              if categoria.activo || String(datos.categoriaId) === String(categoria.id)
                option(value=categoria.id selected=String(datos.categoriaId) === String(categoria.id)) #{categoria.nombre}#{categoria.activo ? '' : ' (inactiva)'}
          if errores.categoriaId
            p#categoriaId-error.error-campo= errores.categoriaId
        +campo('marca','Marca','text',datos.marca,errores,{maxlength:80})
        +campo('ubicacion','Ubicación','text',datos.ubicacion,errores,{maxlength:80})
        +campo('compra','Precio de compra (COP) *','number',datos.compra,errores,{min:0,max:'9999999999.99',step:'0.01',required:true})
        +campo('venta','Precio de venta (COP) *','number',datos.venta,errores,{min:0,max:'9999999999.99',step:'0.01',required:true})
        if !edicion
          +campo('stock','Existencias iniciales *','number',datos.stock,errores,{min:0,max:2147483647,step:1,required:true})
        else
          .campo
            label Existencias
            p.nota El stock se consulta en el detalle. No se modifica desde este formulario.
            if errores.stock
              p.error-campo= errores.stock
        +campo('minimo','Cantidad mínima *','number',datos.minimo,errores,{min:0,max:2147483647,step:1,required:true})
        .campo
          label(for='activo') Estado *
          select#activo(name='activo' aria-invalid=errores.activo ? 'true' : 'false')
            option(value='1' selected=String(datos.activo) === '1' || datos.activo === true) Activo
            option(value='0' selected=String(datos.activo) === '0' || datos.activo === false) Inactivo
          if errores.activo
            p.error-campo= errores.activo
      if !edicion
        p.nota Las existencias iniciales se registrarán junto con un movimiento de inventario, incluso si son cero. Responsable: operador local configurado.
      .acciones-formulario
        a.boton.secundario(href='/productos') Cancelar
        button.boton.primario(type='submit')= edicion ? 'Guardar cambios' : 'Crear producto'
