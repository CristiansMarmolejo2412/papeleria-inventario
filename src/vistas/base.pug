include componentes
doctype html
html(lang='es')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    title #{titulo} · Papelería
    link(rel='icon' href='/icono.svg' type='image/svg+xml')
    link(rel='stylesheet' href='/css/app.css')
    script(src='/js/app.js' defer)
    block scripts
  body
    a.saltar(href='#contenido') Saltar al contenido
    aside#menu.lateral
      a.marca(href='/')
        img(src='/icono.svg' alt='' width='38' height='44')
        span.marca-texto
          strong Papelería
          small Inventario y ventas
      button.cerrar-menu(type='button' aria-label='Cerrar menú' data-menu)
        +icono('menu')
      nav(aria-label='Navegación principal')
        each grupo in [{nombre:'PRINCIPAL', enlaces:[['/','inicio','Inicio'],['/ventas/nueva','ventas','Nueva venta'],['/ventas','documento','Historial de ventas'],['/productos','productos','Productos'],['/inventario','productos','Inventario'],['/categorias','documento','Categorías']]},{nombre:'GESTIÓN',enlaces:[['/pendiente/clientes','clientes','Clientes'],['/pendiente/proveedores','documento','Proveedores'],['/pendiente/compras','documento','Compras'],['/pendiente/caja','caja','Caja y gastos'],['/pendiente/reportes','documento','Reportes'],['/pendiente/movimientos','documento','Movimientos']]},{nombre:'ADMINISTRACIÓN',enlaces:[['/pendiente/usuarios','clientes','Usuarios'],['/pendiente/configuracion','ajustes','Configuración']]}]
          p.grupo= grupo.nombre
          each item in grupo.enlaces
            a.nav-item(href=item[0] class=ruta === item[0] ? 'seleccionado' : '' aria-current=ruta === item[0] ? 'page' : undefined title=item[2])
              +icono(item[1])
              span= item[2]
      .nota-local
        span.punto
        span Operación local · Inventario y ventas
    .area-principal
      header.cabecera
        .flex.items-center.gap-3
          button.boton-menu(type='button' data-menu aria-controls='menu' aria-expanded='true' aria-label='Plegar o desplegar menú')
            +icono('menu')
          div
            h1= titulo
            p.subtitulo Todo en su lugar, para un buen día de trabajo.
        .perfil
          span.avatar L
          div
            strong Operador local
            small Usuarios y permisos pendientes
      main#contenido(tabindex='-1')
        if aviso
          .aviso(role='status')
            span ✓ #{aviso}
            button(type='button' data-cerrar-aviso aria-label='Cerrar mensaje') ×
        block contenido
      footer Papelería · Inventario local en pesos colombianos
