extends base
block contenido
  section.tarjeta
    .encabezado-panel
      div
        h2 Tus proveedores
        p.subtitulo Contactos y abastecimiento de tu papelería.
      a.boton.primario(href='/proveedores/nuevo')
        +icono('mas')
        | Nuevo proveedor
    form.filtros-historial(method='get' action='/proveedores')
      .campo
        label(for='q-proveedor') Buscar proveedor
        input#q-proveedor(name='q' value=filtros.q placeholder='Nombre, identificación o contacto' maxlength='160')
      .campo
        label(for='estado-proveedor') Estado
        select#estado-proveedor(name='estado')
          option(value='activos' selected=!filtros.estado || filtros.estado==='activos') Activos
          option(value='inactivos' selected=filtros.estado==='inactivos') Inactivos
          option(value='todos' selected=filtros.estado==='todos') Todos
      button.boton.secundario(type='submit') Buscar
    if proveedores.length
      .tabla-contenedor(tabindex='0' role='region' aria-label='Tabla de proveedores; permite desplazamiento horizontal')
        table
          thead
            tr
              each texto in ['Proveedor','Identificación','Contacto','Teléfono / correo','Estado','Acciones']
                th(scope='col')= texto
          tbody
            each proveedor in proveedores
              tr
                td.nombre-comprobante= proveedor.nombre
                td= proveedor.identificacion || 'Sin identificación'
                td= proveedor.contacto || 'Sin contacto'
                td
                  div= proveedor.telefono || 'Sin teléfono'
                  small= proveedor.correo || 'Sin correo'
                td
                  span.etiqueta(class=proveedor.activo ? 'verde' : 'gris')= proveedor.activo ? 'Activo' : 'Inactivo'
                td
                  .acciones-proveedor
                    a.enlace(href='/proveedores/'+proveedor.id+'/editar') Editar
                    a.enlace(href='/compras?proveedor='+proveedor.id) Compras
                    if proveedor.activo
                      form(method='post' action='/proveedores/'+proveedor.id+'/desactivar' data-confirmar='¿Desactivar el proveedor? Sus compras se conservarán.' data-guardar)
                        input(type='hidden' name='_csrf' value=csrf)
                        button.enlace(type='submit') Desactivar
      nav.paginacion(aria-label='Paginación de proveedores')
        span #{total} #{total===1 ? 'proveedor' : 'proveedores'} · Página #{pagina} de #{paginas}
        .flex.gap-2
          if pagina>1
            a.boton.secundario(href=enlace({pagina:pagina-1})) Anterior
          if pagina<paginas
            a.boton.secundario(href=enlace({pagina:pagina+1})) Siguiente
    else
      .vacio
        +icono('documento')
        h3 No hay proveedores para mostrar
        p Crea tu primer proveedor o cambia la búsqueda.
